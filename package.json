{
  "name": "@anhldh/gltf-animation-pointer-extensions",
  "version": "0.1.1",
  "description": "KHR_animation_pointer support for three.js (GLTFLoader) and gltf-transform.",
  "keywords": [
    "gltf",
    "glb",
    "three",
    "threejs",
    "gltf-transform",
    "KHR_animation_pointer",
    "animation"
  ],
  "license": "MIT",
  "author": "anhldh",
  "homepage": "https://github.com/anhldh/gltf-animation-pointer-extensions#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anhldh/gltf-animation-pointer-extensions.git"
  },
  "bugs": {
    "url": "https://github.com/anhldh/gltf-animation-pointer-extensions/issues"
  },
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./transform": {
      "types": "./dist/transform.d.ts",
      "import": "./dist/transform.js",
      "require": "./dist/transform.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "three": ">=0.150.0",
    "@gltf-transform/core": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    },
    "@gltf-transform/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.4.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "r3f-monitor": "^2.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vite-plugin-dts": "^5.0.3"
  }
}
